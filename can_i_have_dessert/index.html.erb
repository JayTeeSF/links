<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Can I have dessert?</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.5;
      color: #222;
      background: #f5f5f7;
    }
    body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .container {
      max-width: 640px;
      width: 100%;
      padding: 24px 20px 32px;
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    }
    h1 {
      margin: 0 0 16px;
      font-size: 1.8rem;
      text-align: center;
    }
    #slide_text {
      font-size: 1.1rem;
      margin-bottom: 16px;
    }
    #slide_comment {
      font-size: 0.85rem;
      color: #555;
      margin-top: 24px;
    }
    .btn {
      display: inline-block;
      padding: 10px 18px;
      border-radius: 999px;
      text-decoration: none;
      font-size: 0.95rem;
      cursor: pointer;
      border: none;
      margin: 4px 0;
    }
    .btn-primary {
      background: #2563eb;
      color: #fff;
    }
    .btn-secondary {
      background: #e5e7eb;
      color: #111827;
    }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-secondary:hover { background: #d1d5db; }
    .center { text-align: center; }
    .hidden { display: none; }
  </style>
</head>
<body>
  <main class="container">
    <h1 id="title"></h1>

    <div id="intro-screen" class="center">
      <p id="intro-text"></p>
      <button id="start-button" class="btn btn-primary">Get Started</button>
    </div>

    <div id="question-screen" class="hidden">
      <div id="slide">
        <p id="slide_text"></p>
        <div id="buttons" class="center"></div>
        <p id="slide_comment" class="hidden"></p>
      </div>
    </div>
  </main>

  <% require "csv"; require "json" %>
  <% rows = CSV.read(File.join(__dir__, "survey.csv"), headers: true) %>

  <script>
    // Data generated from survey.csv
    const surveyScreens = [
    <% rows.each_with_index do |row, idx| %>
      {
        id: <%= row["id"].to_s.to_json %>,
        isStart: <%= (row["is_start"].to_s.downcase == "true").to_json %>,
        isDone: <%= (row["is_done"].to_s.downcase == "true").to_json %>,
        inputType: <%= row["input_type"].to_s.downcase.to_json %>,
        autoAction: <%= row["auto_action"].to_s.to_json %>,
        autoArg: <%= row["auto_arg"].to_s.to_json %>,
        questionText: <%= row["question_text"].to_s.to_json %>,
        helperText: <%= row["helper_text"].to_s.to_json %>,
        yesNextId: <%= row["yes_next_id"].to_s.to_json %>,
        yesMessage: <%= row["yes_message"].to_s.to_json %>,
        noNextId: <%= row["no_next_id"].to_s.to_json %>,
        noMessage: <%= row["no_message"].to_s.to_json %>
      }<%= "," unless idx == rows.size - 1 %>
    <% end %>
    ];

    const surveyById = Object.fromEntries(surveyScreens.map(s => [s.id, s]));
    const startScreen = surveyScreens.find(s => s.isStart);
    const doneScreenId = (surveyScreens.find(s => s.isDone) || {}).id;

    function setIntro() {
      const intro = document.getElementById("intro-screen");
      const questionScreen = document.getElementById("question-screen");
      const title = document.getElementById("title");
      const introText = document.getElementById("intro-text");

      if (startScreen) {
        title.textContent = startScreen.questionText || "Can I have dessert?";
        introText.textContent = "Answer a few quick questions to see if you've earned dessert.";
      } else {
        title.textContent = "Can I have dessert?";
        introText.textContent = "Survey not configured.";
      }

      intro.classList.remove("hidden");
      questionScreen.classList.add("hidden");
    }

    function formatTzDateTime(date, timeZone) {
      return date.toLocaleString("en-US", {
        timeZone,
        dateStyle: "medium",
        timeStyle: "short"
      });
    }

    const autoActions = {
      // autoArg: "HH:MM,TimeZoneName"
      CHECK_AFTER_TIME(screen) {
        const arg = screen.autoArg || "20:15,America/Los_Angeles";
        const [timePart, tz = "America/Los_Angeles"] = arg.split(",");
        const [hStr, mStr] = timePart.split(":");
        const hour = parseInt(hStr, 10) || 20;
        const minute = parseInt(mStr, 10) || 15;

        const now = new Date();
        const nowInTz = new Date(now.toLocaleString("en-US", { timeZone: tz }));
        const cutoff = new Date(nowInTz.getTime());
        cutoff.setHours(hour, minute, 0, 0);

        const after = nowInTz > cutoff;
        const currentTime = formatTzDateTime(nowInTz, tz);
        const cutoffTime = formatTzDateTime(cutoff, tz);

        if (after) {
          let msg = screen.yesMessage || "";
          msg = msg.replace("{current_time}", currentTime)
                   .replace("{cutoff_time}", cutoffTime);
          return { message: msg };
        } else {
          return { nextId: screen.noNextId || null };
        }
      }
    };

    function showMessageWithRetry(text) {
      const intro = document.getElementById("intro-screen");
      const questionScreen = document.getElementById("question-screen");
      const slideTextEl = document.getElementById("slide_text");
      const commentEl = document.getElementById("slide_comment");
      const buttonsEl = document.getElementById("buttons");

      intro.classList.add("hidden");
      questionScreen.classList.remove("hidden");

      slideTextEl.innerHTML = text;
      commentEl.classList.add("hidden");
      commentEl.textContent = "";
      buttonsEl.innerHTML = "";

      const tryAgain = document.createElement("a");
      tryAgain.href = "/links/can_i_have_dessert";
      tryAgain.textContent = "Try Again";
      tryAgain.className = "btn btn-primary";
      buttonsEl.appendChild(tryAgain);
    }

    function gotoScreen(id) {
      if (!id) {
        setIntro();
        history.pushState({}, "", "/links/can_i_have_dessert");
        return;
      }
      const url = "/links/can_i_have_dessert?id=" + encodeURIComponent(id);
      history.pushState({}, "", url);
      renderFromUrl();
    }

    function renderScreen(screen) {
      const intro = document.getElementById("intro-screen");
      const questionScreen = document.getElementById("question-screen");
      const slideTextEl = document.getElementById("slide_text");
      const commentEl = document.getElementById("slide_comment");
      const buttonsEl = document.getElementById("buttons");

      if (!screen) {
        showMessageWithRetry("What cho' talkin' 'bout Willis?");
        return;
      }

      // Auto screens: use configured action
      if (screen.inputType === "auto") {
        const action = autoActions[screen.autoAction];
        if (!action) {
          showMessageWithRetry("Configuration error: unknown auto_action.");
          return;
        }
        const result = action(screen);
        if (result.message) {
          showMessageWithRetry(result.message);
        } else if (result.nextId) {
          gotoScreen(result.nextId);
        } else {
          showMessageWithRetry("Configuration error: auto_action produced no result.");
        }
        return;
      }

      intro.classList.add("hidden");
      questionScreen.classList.remove("hidden");

      // Done / message-only screens
      if (screen.inputType === "none") {
        let text = screen.questionText || "";
        if (screen.isDone) {
          const uuid =
            (window.crypto && crypto.randomUUID)
              ? crypto.randomUUID()
              : Math.random().toString(36).slice(2);
          text += " use this secret (unique) id: " + uuid;
        }
        slideTextEl.innerHTML = text;
        commentEl.classList.add("hidden");
        commentEl.textContent = "";
        buttonsEl.innerHTML = "";
        return;
      }

      // Yes/No question screens
      slideTextEl.innerHTML = screen.questionText || "";
      if (screen.helperText) {
        commentEl.innerHTML = screen.helperText;
        commentEl.classList.remove("hidden");
      } else {
        commentEl.classList.add("hidden");
        commentEl.textContent = "";
      }

      buttonsEl.innerHTML = "";

      const yesBtn = document.createElement("a");
      yesBtn.href = "javascript:void(0)";
      yesBtn.className = "btn btn-primary";
      yesBtn.textContent = "yes, uhm, yeah sort of";

      const noBtn = document.createElement("a");
      noBtn.href = "javascript:void(0)";
      noBtn.className = "btn btn-secondary";
      noBtn.textContent = "no";

      yesBtn.onclick = function () {
        handleAnswer(screen, "yes");
      };
      noBtn.onclick = function () {
        handleAnswer(screen, "no");
      };

      buttonsEl.appendChild(yesBtn);
      buttonsEl.appendChild(document.createElement("br"));
      buttonsEl.appendChild(noBtn);
    }

    function handleAnswer(screen, branch) {
      const nextId = branch === "yes" ? screen.yesNextId : screen.noNextId;
      const message = branch === "yes" ? screen.yesMessage : screen.noMessage;

      if (message && message.trim() !== "") {
        showMessageWithRetry(message);
        return;
      }

      if (!nextId) {
        showMessageWithRetry("Configuration error: no next screen.");
        return;
      }

      if (nextId === doneScreenId) {
        gotoScreen(nextId);
        return;
      }

      gotoScreen(nextId);
    }

    function renderFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const id = params.get("id");
      if (!id) {
        setIntro();
        return;
      }
      const screen = surveyById[id];
      renderScreen(screen);
    }

    window.addEventListener("popstate", renderFromUrl);

    window.addEventListener("DOMContentLoaded", function () {
      setIntro();

      const startBtn = document.getElementById("start-button");
      if (startBtn) {
        startBtn.addEventListener("click", function () {
          const firstId = (startScreen && startScreen.yesNextId) || "1";
          gotoScreen(firstId);
        });
      }

      renderFromUrl();
    });
  </script>
</body>
</html>
