<h1>JT's Links</h1>

<!-- Why Section -->
<div class="alert alert-info mt-3">
  <h3>Why This Page?</h3>
  <p>
    I created this page to share my favorite "media" with family and friends. Whether you're in a show-hole or looking for a great new movie, TV series, podcast, or other content, this page will help you discover something worthwhile. 
  </p>
  <p>
    My star ratings are as follows:
    <ul>
      <li><strong>1-2 stars:</strong> Meh. Skip it unless you're really interested in the topic.</li>
      <li><strong>3 stars:</strong> Entertaining. Worth a watch/listen if you like the genre.</li>
      <li><strong>4 stars:</strong> Great content. Highly recommended.</li>
      <li><strong>5 stars:</strong> Must-watch! Even if you're not a fan of the genre, it's too good to miss.</li>
    </ul>
  </p>
</div>

<!-- How to Use Section -->
<div class="alert alert-warning">
  <h3>How to Use This Page</h3>
  <ul>
    <li><strong>Search:</strong> Use the search bar to find content by keyword, title, or tags (e.g., "action," "comedy").</li>
    <li><strong>Filter:</strong> Select specific tags (e.g., "video+humor") to narrow down the results. You can combine multiple tags for advanced filtering.</li>
    <li><strong>Sort:</strong> Use the "Sort By" dropdown to organize results by title or rating, either ascending or descending.</li>
    <li><strong>Favorites:</strong> By default, the page shows my favorites. Switch to "All Links" to see everything.</li>
    <li><strong>Clear Filters:</strong> Click the "Clear Filters" button to reset all filters and return to the default view.</li>
    <li><strong>Modal View:</strong> Click a thumbnail to view a larger version of the image in a pop-up modal.</li>
  </ul>
</div>

<!-- Spinner for loading feedback -->
<div id="loading-spinner" style="display: none;" class="mb-3">
  <div class="spinner-border text-primary" role="status">
    <span class="visually-hidden">Loading...</span>
  </div>
</div>

<!-- Sorting Controls -->
<div class="sorting-controls mb-3">
  <label for="sort-select">Sort By:</label>
  <select id="sort-select" class="form-select">
    <option value="title">Title (A-Z)</option>
    <option value="title-desc">Title (Z-A)</option>
    <option value="rating">Rating (High to Low)</option>
    <option value="rating-desc">Rating (Low to High)</option>
  </select>
</div>

<!-- Dynamic Tag Selection -->
<div class="filter-controls mb-3">
  <label for="tag-select">Select Tags:</label>
  <select id="tag-select" class="form-select" multiple>
    <% unique_tags = @data.flat_map { |link| link['tags'] }.uniq.sort %>
    <% unique_tags.each do |tag| %>
      <option value="<%= tag.downcase %>"><%= tag.capitalize %></option>
    <% end %>
  </select>

  <button id="add-tag" class="btn btn-primary mt-2">Add Tag</button>
  <button id="filter-btn" class="btn btn-success mt-2">Filter</button>
  <button id="clear-filters" class="btn btn-danger mt-2">Clear Filters</button>

  <!-- Predefined Filters -->
  <button class="btn btn-secondary" data-filter="video+humor">Video + Humor</button>
  <button class="btn btn-secondary" data-filter="video+trailer+humor">Video + Trailer + Humor</button>
</div>

<!-- Search Bar -->
<input type="search" id="search" class="form-control mb-3" placeholder="Search by keyword, tag, or category...">

<!-- Links Section -->
<div id="links">
  <% @data.each_with_index do |link, index| %>
    <div class="card mb-3 <%= 'favorite' if link['favorite'] %>" data-tags="<%= link['tags'].join(', ') %>">
      <img src="<%= link['thumbnail'] %>" class="card-img-top thumbnail" alt="<%= link['link_text'] %>" data-bs-toggle="modal" data-bs-target="#imageModal-<%= index %>">
      <div class="card-body">
        <h5 class="card-title">
          <a href="<%= link['url'] %>" target="_blank"><%= link['link_text'] %></a>
          <% if link['favorite'] %>
            <span class="badge bg-warning text-dark">★ Favorite</span>
          <% end %>
        </h5>
        <p class="card-text"><%= link['snippet'] %></p>
        <p class="card-text">
          <strong>Rating:</strong> <%= "⭐" * link['rating'] %><br>
          <strong>Category:</strong> <%= link['category'].capitalize %><br>
          <strong>Date Added:</strong> <%= link['date_added'] %><br>
          <strong>Tags:</strong> <%= link['tags'].join(', ') %>
        </p>
      </div>
    </div>

    <!-- Modal for Full-Size Image -->
    <div class="modal fade" id="imageModal-<%= index %>" tabindex="-1" aria-labelledby="modalLabel-<%= index %>" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="modalLabel-<%= index %>"><%= link['link_text'] %></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <img src="<%= link['full_image'] %>" class="img-fluid" alt="<%= link['link_text'] %>">
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
